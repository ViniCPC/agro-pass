# Copie para .env.local e ajuste.

# URL da API NestJS. Para testar no celular pela rede local, use o IP da
# máquina (ex.: http://192.168.0.10:3000) e inclua a origem do app em
# CORS_ORIGINS no backend.
VITE_API_URL=http://localhost:3000

# URL pública DEFINITIVA do frontend. É o endereço gravado nos QR Codes
# (<VITE_PUBLIC_APP_URL>/trace/<código público>). Etiquetas impressas não
# podem ser corrigidas depois: em produção, use o domínio final. Se ficar
# vazia, o QR usa o endereço em que o app está aberto.
VITE_PUBLIC_APP_URL=

# Rede Solana dos links do explorer: devnet | testnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet

# Subcaminho de hospedagem (ex.: /agro-pass/ no GitHub Pages).
VITE_BASE_PATH=/
