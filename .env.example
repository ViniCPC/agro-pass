# =============================================================
# PostgreSQL
# =============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=agro_pass
POSTGRES_PORT=5432

# =============================================================
# Bot do Telegram
# Obtenha o token via @BotFather no Telegram
# =============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true

# =============================================================
# Gemini (Google AI) — conversa inteligente no bot
# Obtenha a chave em: https://aistudio.google.com/apikey
# =============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =============================================================
# URLs públicas (usadas nos QR Codes gerados para os lotes)
# Em desenvolvimento local, deixe em branco.
# =============================================================
PUBLIC_BACKEND_URL=
PUBLIC_BATCHES_URL=
QR_PDF_PUBLIC_BASE_URL=

# =============================================================
# Configurações gerais do backend
# =============================================================
SATELLITE_PROVIDER=MOCK
HEALTHCHECK_SOLANA_ENABLED=false
CORS_ORIGINS=http://localhost:5173

# =============================================================
# Solana (devnet) — opcional, só necessário para mint de cNFTs
# =============================================================
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_KEYPAIR_PATH=./keys/treasury-devnet.json
SOLANA_MERKLE_TREE=

# =============================================================
# Anthropic — opcional, necessário para parsing de CAR via IA
# =============================================================
ANTHROPIC_API_KEY=

# =============================================================
# Frontend (build-time — usada pelo Vite para apontar para a API)
# Para desenvolvimento local com Docker, mantenha o padrão.
# =============================================================
VITE_API_URL=http://localhost:3000
