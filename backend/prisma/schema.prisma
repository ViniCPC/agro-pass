// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USUÁRIOS E ATORES
// ============================================

model Producer {
  id              String   @id @default(uuid())
  name            String
  phone           String
  document        String?  @unique // CPF
  telegramUserId  String?  @unique // ID no Telegram pra linkar com bot
  walletAddress   String?  @unique // Carteira Solana custodial
  reputationScore Int      @default(0) 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farms          Farm[]
  carbonCredits  CarbonCredit[]

  @@index([telegramUserId])
}

model Cooperative {
  id              String   @id @default(uuid())
  name            String
  document        String   @unique // CNPJ
  city            String
  state           String
  walletAddress   String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  traceEvents TraceEvent[]
}

model Exporter {
  id              String   @id @default(uuid())
  name            String
  document        String   @unique // CNPJ
  email           String   @unique
  walletAddress   String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sales       Sale[]
  traceEvents TraceEvent[]
}

// ============================================
// FAZENDA E ÁREA
// ============================================

model Farm {
  id                String     @id @default(uuid())
  name              String
  city              String
  state             String
  latitude          Float
  longitude         Float
  carNumber         String?    @unique  // CAR é único nacional
  
  // Dados pro cálculo EUDR + Carbono
  totalAreaHa       Float?     // hectares totais
  legalReserveAreaHa Float?    // RL declarada no CAR
  appAreaHa         Float?     // APP declarada
  consolidatedAreaHa Float?    // área de uso (lavoura, pasto)
  biome             Biome?     // Cerrado, Amazônia, etc.
  isAmazonLegal     Boolean    @default(false)
  
  // Validação ambiental
  isEudrCompliant   Boolean    @default(false)
  eudrEvidenceUrl   String?    // link pra evidência (satélite, MapBiomas)
  validatedAt       DateTime?
  
  // Excedente preservado (gera crédito de carbono)
  preservedSurplusHa Float?    @default(0)
  
  status            FarmStatus @default(PENDING)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  producerId String
  producer   Producer @relation(fields: [producerId], references: [id])

  batches        Batch[]
  carbonCredits  CarbonCredit[]
  documents      Document[]

  @@index([producerId])
  @@index([state])
}

// ============================================
// LOTE (CORAÇÃO DO SISTEMA)
// ============================================

model Batch {
  id          String      @id @default(uuid())
  code        String      @unique // CAF-2026-0001
  productType ProductType
  quantity    Int
  unit        String
  harvestDate DateTime?
  status      BatchStatus @default(CREATED)

  // Solana / cNFT
  cnftAddress String?     @unique
  merkleTree  String?     // tree onde o cNFT vive
  metadataUri String?     // link Arweave/IPFS
  qrCodeUrl   String?
  mintTxHash  String?     // tx de mint

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmId String
  farm   Farm @relation(fields: [farmId], references: [id])

  documents      Document[]
  traceEvents    TraceEvent[]
  saleItems      SaleItem[]

  @@index([farmId])
  @@index([status])
  @@index([productType])
}

// ============================================
// DOCUMENTOS
// ============================================

model Document {
  id        String       @id @default(uuid())
  type      DocumentType
  fileUrl   String
  fileHash  String       @unique // SHA-256
  createdAt DateTime     @default(now())

  // Pode pertencer a Farm OU a Batch
  farmId    String?
  farm      Farm?  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  
  batchId   String?
  batch     Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([batchId])
}

// ============================================
// EVENTOS DE RASTREABILIDADE
// ============================================

model TraceEvent {
  id        String         @id @default(uuid())
  type      TraceEventType
  
  // Quem registrou (um dos três, dependendo do evento)
  actorName     String     // Sempre preenchido pra display
  cooperativeId String?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id])
  exporterId    String?
  exporter      Exporter?    @relation(fields: [exporterId], references: [id])
  
  location  String?
  latitude  Float?
  longitude Float?
  
  // Prova on-chain
  eventHash String?        // hash do evento (sha256 dos campos)
  txHash    String?        // tx Solana se on-chain
  
  createdAt DateTime @default(now())

  batchId String
  batch   Batch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([type])
}

// ============================================
// CRÉDITO DE CARBONO (FEATURE NOVA)
// ============================================

model CarbonCredit {
  id              String              @id @default(uuid())
  
  hectares        Float               // hectares preservados que geram este crédito
  tonnesCo2e      Float               // toneladas de CO2 equivalente
  factor          Float               // tCO2/ha/ano usado no cálculo
  vintage         Int                 // ano de referência (2026)
  
  // Solana
  tokenMint       String?  @unique    // SPL token mint address
  amountMinted    BigInt   @default(0) // quantidade total de tokens emitidos
  
  status          CarbonCreditStatus  @default(ISSUED)
  pricePerTonneUsd Float?  @default(15)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  producerId String
  producer  Producer @relation(fields: [producerId], references: [id])
  
  saleItems SaleItem[]

  @@index([farmId])
  @@index([status])
}

// ============================================
// VENDAS (importador comprando)
// ============================================

model Sale {
  id              String     @id @default(uuid())
  
  totalUsd        Float
  paymentTxHash   String?    @unique // tx Solana Pay
  paymentTokenMint String?   // USDC mint, normalmente
  status          SaleStatus @default(PENDING)
  
  buyerWallet     String     // wallet do importador
  buyerEmail      String?
  buyerCountry    String?    // pra rastreabilidade EUDR
  
  createdAt       DateTime   @default(now())
  paidAt          DateTime?
  
  exporterId      String
  exporter        Exporter   @relation(fields: [exporterId], references: [id])
  
  items           SaleItem[]

  @@index([exporterId])
  @@index([status])
}

model SaleItem {
  id          String  @id @default(uuid())
  
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  // Pode ser um lote ou um crédito de carbono
  batchId     String?
  batch       Batch?  @relation(fields: [batchId], references: [id])
  
  carbonCreditId String?
  carbonCredit   CarbonCredit? @relation(fields: [carbonCreditId], references: [id])
  
  quantity    Float   // sacas/ha de carbono
  unitPriceUsd Float
  totalUsd    Float

  @@index([saleId])
}

// ============================================
// ENUMS
// ============================================

enum ProductType {
  COFFEE
  SOY
  CATTLE
  COCOA
  PALM_OIL
  RUBBER
  WOOD
}

enum FarmStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BatchStatus {
  CREATED
  VERIFIED
  MINTED
  IN_TRANSIT
  EXPORTED
  SOLD
}

enum DocumentType {
  CAR
  INVOICE
  WAREHOUSE_RECEIPT
  ENVIRONMENTAL_REPORT
  SATELLITE_IMAGE
  OTHER
}

enum TraceEventType {
  CREATED
  HARVESTED
  RECEIVED_BY_COOPERATIVE
  TRANSPORTED
  PROCESSED
  EXPORTED
  MINTED_ONCHAIN
  SOLD
}

enum Biome {
  AMAZON
  CERRADO
  ATLANTIC_FOREST
  CAATINGA
  PAMPA
  PANTANAL
}

enum CarbonCreditStatus {
  ISSUED
  AVAILABLE
  RESERVED
  SOLD
  RETIRED
}

enum SaleStatus {
  PENDING
  PAID
  DELIVERED
  CANCELLED
  REFUNDED
}

// ============================================
// HISTÓRICO DE CONVERSAÇÃO (Gemini)
// ============================================

model ConversationMessage {
  id             String      @id @default(uuid())
  telegramUserId String
  role           MessageRole
  content        String

  createdAt      DateTime    @default(now())

  @@index([telegramUserId, createdAt])
}

enum MessageRole {
  USER
  MODEL
}
