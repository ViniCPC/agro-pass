// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USUÁRIOS E ATORES
// ============================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producerId    String?      @unique
  producer      Producer?    @relation(fields: [producerId], references: [id])
  cooperativeId String?      @unique
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id])

  recordedEvents TraceEvent[] @relation("RecordedEvents")
}

model Producer {
  id              String  @id @default(uuid())
  name            String
  phone           String  @unique
  document        String  @unique
  walletAddress   String? @unique
  reputationScore Int     @default(0)

  cooperativeId String?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms Farm[]
  user  User?

  @@index([cooperativeId])
  @@index([document])
}

model Cooperative {
  id            String          @id @default(uuid())
  name          String
  document      String          @unique
  city          String
  state         String
  walletAddress String?         @unique
  inviteCode    String          @unique @default(uuid())
  plan          CooperativePlan @default(BASIC)
  monthlyFee    Float?
  contractedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producers Producer[]
  user      User?
}

model Exporter {
  id            String  @id @default(uuid())
  name          String
  document      String  @unique
  email         String  @unique
  walletAddress String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// FAZENDA
// ============================================

model Farm {
  id String @id @default(uuid())

  name      String
  city      String
  state     String
  latitude  Float
  longitude Float
  carNumber String? @unique

  // Polígono real da propriedade (do SICAR)
  polygonGeoJson Json?

  totalAreaHa Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producerId String
  producer   Producer @relation(fields: [producerId], references: [id])

  batches   Batch[]
  documents Document[]

  @@index([producerId])
  @@index([state])
}

// ============================================
// LOTES
// ============================================

model Batch {
  id          String      @id @default(uuid())
  code        String      @unique
  productType ProductType
  quantity    Int
  unit        String
  harvestDate DateTime?
  status      BatchStatus @default(CREATED)

  publicCode    String    @unique
  isPublic      Boolean   @default(false)
  integrityHash String?
  closedAt      DateTime?

  // Blockchain proof: one cNFT per batch, minted after closing, carrying the
  // final chain hash. Kept on the batch (not as an event) because a closed
  // chain is immutable.
  tokenizationStatus    TokenizationStatus @default(NONE)
  tokenizationAttempts  Int                @default(0)
  tokenizationStartedAt DateTime?
  tokenizationError     String?
  proofHash             String?
  tokenAddress          String?
  tokenTxHash           String?            @unique
  tokenizedAt           DateTime?
  blockchainNetwork     String?

  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id])

  documents   Document[]
  traceEvents TraceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([status])
}

// ============================================
// DOCUMENTOS
// ============================================

model Document {
  id           String       @id @default(uuid())
  type         DocumentType
  originalName String
  storageKey   String       @unique
  fileUrl      String
  size         Int
  mimeType     String
  fileHash     String       @unique
  // Only public documents can be downloaded from the public passport; the
  // others show up there as hash-only evidence.
  isPublic     Boolean      @default(false)
  createdAt    DateTime     @default(now())

  farmId       String?
  farm         Farm?       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  batchId      String?
  batch        Batch?      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  traceEventId String?
  traceEvent   TraceEvent? @relation(fields: [traceEventId], references: [id], onDelete: Restrict)

  @@index([farmId])
  @@index([batchId])
  @@index([traceEventId])
}

// ============================================
// EVENTOS
// ============================================

model TraceEvent {
  id       String         @id @default(uuid())
  type     TraceEventType
  sequence Int

  location  String?
  latitude  Float?
  longitude Float?
  notes     String?

  previousHash String?
  eventHash    String
  txHash       String?

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  recordedById String
  recordedBy   User     @relation("RecordedEvents", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime @default(now())

  correctedEventId String?
  correctedEvent   TraceEvent?  @relation("EventCorrections", fields: [correctedEventId], references: [id], onDelete: Restrict)
  corrections      TraceEvent[] @relation("EventCorrections")
  documents        Document[]

  @@unique([batchId, sequence])
  @@index([batchId])
  @@index([type])
  @@index([recordedById])
  @@index([correctedEventId])
}

// ============================================
// PEDIDOS DE DEMONSTRAÇÃO (landing page)
// ============================================

model DemoRequest {
  id        String             @id @default(uuid())
  name      String
  company   String
  email     String
  phone     String?
  profile   DemoRequestProfile
  // When the visitor agreed to be contacted (LGPD consent).
  consentAt DateTime
  createdAt DateTime           @default(now())

  @@index([createdAt])
}

// ============================================
// ENUMS
// ============================================

enum ProductType {
  COFFEE
  SOY
  CATTLE
  COCOA
  PALM_OIL
  RUBBER
  WOOD
}

enum BatchStatus {
  CREATED
  HARVESTED
  RECEIVED
  IN_TRANSIT
  PROCESSED
  DELIVERED
  CLOSED
  CANCELLED
}

enum TokenizationStatus {
  NONE
  PENDING
  CONFIRMED
  FAILED
}

enum DocumentType {
  CAR
  INVOICE
  WAREHOUSE_RECEIPT
  OTHER
}

enum TraceEventType {
  CREATED
  HARVESTED
  RECEIVED
  IN_TRANSIT
  PROCESSED
  DELIVERED
  CLOSED
  CANCELLED
  MINTED_ONCHAIN
  DOCUMENT_ATTACHED
  CORRECTION
}

enum DemoRequestProfile {
  PRODUCER
  COOPERATIVE
  CARRIER
  BUYER
}

enum CooperativePlan {
  BASIC
  PRO
  ENTERPRISE
}

enum UserRole {
  PRODUCER
  COOPERATIVE
  OPERATOR
  ADMIN
}
