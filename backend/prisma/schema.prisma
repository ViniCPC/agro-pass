// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USUÁRIOS E ATORES
// ============================================

model Producer {
  id              String  @id @default(uuid())
  name            String
  phone           String  @unique
  document        String  @unique
  telegramUserId  String? @unique
  walletAddress   String? @unique
  reputationScore Int     @default(0)

  cooperativeId String?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms Farm[]

  @@index([telegramUserId])
  @@index([cooperativeId])
  @@index([document])
}

model Cooperative {
  id            String          @id @default(uuid())
  name          String
  document      String          @unique
  city          String
  state         String
  walletAddress String?         @unique
  slug          String          @unique // pra deep links: t.me/AgroPassBot?start=coop_cooxupe
  inviteCode    String          @unique @default(uuid())
  plan          CooperativePlan @default(BASIC)
  monthlyFee    Float?
  contractedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producers   Producer[]
  traceEvents TraceEvent[]
}

model Exporter {
  id            String  @id @default(uuid())
  name          String
  document      String  @unique
  email         String  @unique
  walletAddress String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  traceEvents TraceEvent[]
}

// ============================================
// CONVERSAS TELEGRAM / GEMINI
// ============================================

model ConversationMessage {
  id             String      @id @default(uuid())
  telegramUserId String
  role           MessageRole
  content        String

  createdAt DateTime @default(now())

  @@index([telegramUserId, createdAt])
}

model CarDraft {
  id             String   @id @default(uuid())
  telegramUserId String   @unique
  carData        Json
  imageUrl       String?
  imageFileHash  String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

// ============================================
// FAZENDA
// ============================================

model Farm {
  id String @id @default(uuid())

  name      String
  city      String
  state     String
  latitude  Float
  longitude Float
  carNumber String? @unique

  // Polígono real da propriedade (do SICAR)
  polygonGeoJson Json?
  carRawJson     Json?

  totalAreaHa        Float?
  legalReserveAreaHa Float?
  appAreaHa          Float?
  consolidatedAreaHa Float?
  biome              Biome?
  demoCode           String?
  isAmazonLegal      Boolean @default(false)

  status FarmStatus @default(PENDING)

  // Última validação EUDR
  lastValidationId     String?           @unique
  lastValidation       EudrValidation?   @relation("FarmLastValidation", fields: [lastValidationId], references: [id])
  lastValidationStatus ValidationStatus?
  lastValidationHash   String?
  lastValidatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producerId String
  producer   Producer @relation(fields: [producerId], references: [id])

  batches     Batch[]
  documents   Document[]
  validations EudrValidation[] @relation("FarmValidations")

  @@index([producerId])
  @@index([state])
}

// ============================================
// VALIDAÇÃO EUDR (NOVO — coração do produto)
// ============================================

model EudrValidation {
  id     String           @id @default(uuid())
  status ValidationStatus

  cutoffDate         DateTime @default("2020-12-31T00:00:00Z")
  hectaresDeforested Float    @default(0)

  // Resultado por fonte (JSON cru pra debug e auditoria)
  mapBiomasResult Json?
  prodesResult    Json?
  hansenResult    Json?

  // Evidências visuais
  satelliteImageBeforeUrl String? // Sentinel-2 ~Dez/2020
  satelliteImageAfterUrl  String? // Sentinel-2 atual
  ndviBefore              Float?
  ndviAfter               Float?

  // Auditoria
  evidenceHash String // sha256 de tudo combinado
  validatedAt  DateTime @default(now())
  validUntil   DateTime // 6 meses

  farmId String
  farm   Farm   @relation("FarmValidations", fields: [farmId], references: [id])

  // Backref pra Farm.lastValidation
  farmAsLast Farm? @relation("FarmLastValidation")

  @@index([farmId])
  @@index([status])
}

// ============================================
// LOTES
// ============================================

model Batch {
  id          String      @id @default(uuid())
  code        String      @unique
  productType ProductType
  quantity    Int
  unit        String
  harvestDate DateTime?
  status      BatchStatus @default(CREATED)

  cnftAddress String? @unique
  merkleTree  String?
  metadataUri String?
  qrCodeUrl   String?
  mintTxHash  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id])

  documents   Document[]
  traceEvents TraceEvent[]

  @@index([farmId])
  @@index([status])
}

// ============================================
// DOCUMENTOS
// ============================================

model Document {
  id        String       @id @default(uuid())
  type      DocumentType
  fileUrl   String
  fileHash  String       @unique
  createdAt DateTime     @default(now())

  farmId  String?
  farm    Farm?   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([batchId])
}

// ============================================
// EVENTOS
// ============================================

model TraceEvent {
  id   String         @id @default(uuid())
  type TraceEventType

  actorName     String
  cooperativeId String?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id])
  exporterId    String?
  exporter      Exporter?    @relation(fields: [exporterId], references: [id])

  location  String?
  latitude  Float?
  longitude Float?

  eventHash String? // sha256 dos campos
  txHash    String? // tx Solana

  createdAt DateTime @default(now())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([type])
}

// ============================================
// ENUMS
// ============================================

enum ProductType {
  COFFEE
  SOY
  CATTLE
  COCOA
  PALM_OIL
  RUBBER
  WOOD
}

enum FarmStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BatchStatus {
  CREATED
  VERIFIED
  MINTED
  IN_TRANSIT
  EXPORTED
}

enum DocumentType {
  CAR
  INVOICE
  WAREHOUSE_RECEIPT
  ENVIRONMENTAL_REPORT
  SATELLITE_IMAGE
  OTHER
}

enum TraceEventType {
  CREATED
  HARVESTED
  RECEIVED_BY_COOPERATIVE
  TRANSPORTED
  PROCESSED
  EXPORTED
  MINTED_ONCHAIN
  EUDR_VALIDATED
}

enum Biome {
  AMAZON
  CERRADO
  ATLANTIC_FOREST
  CAATINGA
  PAMPA
  PANTANAL
}

enum ValidationStatus {
  PENDING
  COMPLIANT
  NON_COMPLIANT
  NEEDS_REVIEW
  EXPIRED
}

enum CooperativePlan {
  BASIC
  PRO
  ENTERPRISE
}

enum MessageRole {
  USER
  MODEL
}
