# =============================================================
# Banco de dados
# =============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=agropass-documents

# =============================================================
# Servidor
# =============================================================
PORT=3000
NODE_ENV=development
LOG_FORMAT=json
# Numero de proxies confiaveis. Use false quando exposto diretamente.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Pedidos de demonstração enviados pela landing page.
DEMO_REQUEST_RATE_LIMIT_PER_MINUTE=5
# Cadastro livre nao verifica a identidade do dono do producerId/cooperativeId.
# Em producao permanece desativado ate existir um fluxo de convite.
ALLOW_PUBLIC_REGISTRATION=false
# Apenas para ambiente dedicado a demonstracao. Nunca misture com dados reais.
SEED_DEMO=false

# "Entrar na demo" (POST /auth/demo): cada visita ganha dados proprios,
# isolados dos reais e apagados ao expirar.
DEMO_SESSION_TTL_HOURS=24
# Teto de visitas abertas ao mesmo tempo, alem do limite por IP.
DEMO_MAX_ACTIVE_SESSIONS=200
# Visitas por IP a cada 10 minutos.
DEMO_SESSION_RATE_LIMIT=5
DEMO_PASSWORD=

# Health check da Solana (so com BLOCKCHAIN_ENABLED=true e provider solana).
# Uma falha da Solana deixa /health "degraded", mas nunca 503: so o banco
# torna a API indisponivel.
HEALTHCHECK_SOLANA_ENABLED=true
HEALTH_SOLANA_TIMEOUT_MS=3000

# =============================================================
# URL pública do FRONTEND — é o endereço gravado nos QR Codes
# (<PUBLIC_APP_URL>/trace/<publicCode>). Etiquetas impressas não
# podem ser corrigidas depois: em produção (NODE_ENV=production) a
# API recusa gerar QR sem esta variável. Use o domínio definitivo.
# =============================================================
PUBLIC_APP_URL=        # ex: https://app.seudominio.com
# URL publica da API: vai nos metadados do cNFT, que e imutavel. Em
# producao a tokenizacao falha (sem afetar o lote) se ela estiver vazia.
PUBLIC_BACKEND_URL=    # ex: https://backend.seudominio.com
QR_PDF_PUBLIC_BASE_URL= # ex: https://backend.seudominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================
# Prova em blockchain: um cNFT por lote, registrado ao ENCERRAR o
# lote com o hash final da cadeia de eventos (gravado no memo da
# transacao). Desligada por padrao: a API funciona por completo sem
# blockchain, e uma falha da Solana nunca altera o lote.
# =============================================================
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_PROVIDER=solana   # solana | local (em memoria, sem rede: testes)
BLOCKCHAIN_NETWORK=devnet    # devnet | testnet | mainnet-beta
BLOCKCHAIN_MAX_ATTEMPTS=3
BLOCKCHAIN_RETRY_DELAY_MS=1000

# Solana (BLOCKCHAIN_PROVIDER=solana). RPC vazio = RPC publico da rede.
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_TREASURY_KEYPAIR_PATH="./keys/treasury-devnet.json"
SOLANA_MERKLE_TREE=
