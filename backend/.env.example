# =============================================================
# Banco de dados
# =============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# =============================================================
# Servidor
# =============================================================
PORT=3000

# Health check:
# true  -> /health considera Solana obrigatorio
# false -> /health ignora Solana (util para dev local/front)
HEALTHCHECK_SOLANA_ENABLED=true
HEALTH_SOLANA_TIMEOUT_MS=3000

# =============================================================
# URL pública do FRONTEND — é o endereço gravado nos QR Codes
# (<PUBLIC_APP_URL>/trace/<publicCode>). Etiquetas impressas não
# podem ser corrigidas depois: em produção (NODE_ENV=production) a
# API recusa gerar QR sem esta variável. Use o domínio definitivo.
# =============================================================
PUBLIC_APP_URL=        # ex: https://app.seudominio.com
PUBLIC_BACKEND_URL=    # ex: https://backend.seudominio.com
QR_PDF_PUBLIC_BASE_URL= # ex: https://backend.seudominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================
# Solana (devnet)
# =============================================================
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_TREASURY_KEYPAIR_PATH="./keys/treasury-devnet.json"
SOLANA_MERKLE_TREE=
