# =============================================================
# Banco de dados
# =============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# =============================================================
# Servidor
# =============================================================
PORT=3000

# Health check:
# true  -> /health considera Solana obrigatorio
# false -> /health ignora Solana (util para dev local/front)
HEALTHCHECK_SOLANA_ENABLED=true
HEALTH_SOLANA_TIMEOUT_MS=3000

# =============================================================
# Bot do Telegram
# Obtenha o token via @BotFather no Telegram
# =============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true

# =============================================================
# Gemini (Google AI) — conversa inteligente no bot
# Obtenha a chave em: https://aistudio.google.com/apikey
# =============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =============================================================
# URL pública da API — usada nos QR Codes gerados para os lotes
# Defina apenas uma; a prioridade é: BATCHES > BACKEND > APP
# =============================================================
PUBLIC_BATCHES_URL=    # ex: https://api.seudominio.com
PUBLIC_BACKEND_URL=    # ex: https://backend.seudominio.com
PUBLIC_APP_URL=        # ex: https://app.seudominio.com
QR_PDF_PUBLIC_BASE_URL= # ex: https://backend.seudominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================
# Evidencia de satelite
# MOCK mantém a demo offline/estavel.
# SENTINEL_HUB tenta buscar imagens reais e cai para MOCK se falhar.
# =============================================================
SATELLITE_PROVIDER=MOCK
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_TOKEN_URL=https://services.sentinel-hub.com/auth/realms/main/protocol/openid-connect/token
SENTINEL_HUB_PROCESS_URL=https://services.sentinel-hub.com/api/v1/process

# =============================================================
# Solana (devnet)
# =============================================================
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_TREASURY_KEYPAIR_PATH="./keys/treasury-devnet.json"
SOLANA_MERKLE_TREE=
